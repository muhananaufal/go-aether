package webhook

import (
	"bytes"
	"context"
	"crypto/hmac"
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"net/http"
	"time"
)

// Dispatcher sends secure signed webhooks to external subscriber endpoints.
type Dispatcher struct {
	client  *http.Client
	secret  []byte
	timeout time.Duration
}

// NewDispatcher creates a new secure Webhook Dispatcher.
func NewDispatcher(secret string, timeout time.Duration) *Dispatcher {
	return &Dispatcher{
		client: &http.Client{
			Timeout: timeout,
		},
		secret:  []byte(secret),
		timeout: timeout,
	}
}

// Dispatch signs payload with HMAC-SHA256 and POSTs to target URL.
func (d *Dispatcher) Dispatch(ctx context.Context, targetURL, eventType string, payload interface{}) error {
	bodyBytes, err := json.Marshal(payload)
	if err != nil {
		return fmt.Errorf("failed to serialize webhook payload: %w", err)
	}

	// Compute HMAC-SHA256 signature
	mac := hmac.New(sha256.New, d.secret)
	mac.Write(bodyBytes)
	signature := hex.EncodeToString(mac.Sum(nil))

	req, err := http.NewRequestWithContext(ctx, http.MethodPost, targetURL, bytes.NewReader(bodyBytes))
	if err != nil {
		return fmt.Errorf("failed to create webhook request: %w", err)
	}

	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("X-Aether-Event", eventType)
	req.Header.Set("X-Aether-Signature", signature)
	req.Header.Set("X-Aether-Timestamp", fmt.Sprintf("%d", time.Now().Unix()))

	resp, err := d.client.Do(req)
	if err != nil {
		return fmt.Errorf("failed to dispatch webhook to %s: %w", targetURL, err)
	}
	defer resp.Body.Close()

	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return fmt.Errorf("webhook endpoint returned non-2xx status: %d", resp.StatusCode)
	}

	return nil
}
