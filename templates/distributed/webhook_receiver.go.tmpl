package webhook

import (
	"bytes"
	"crypto/hmac"
	"crypto/sha256"
	"encoding/hex"
	"io"
	"net/http"
)

// VerifySignature validates that an incoming HTTP request matches the HMAC-SHA256 signature.
func VerifySignature(secret string, r *http.Request) ([]byte, bool) {
	signature := r.Header.Get("X-Aether-Signature")
	if signature == "" {
		return nil, false
	}

	body, err := io.ReadAll(r.Body)
	if err != nil {
		return nil, false
	}
	// Restore body reader for downstream handlers
	r.Body = io.NopCloser(bytes.NewBuffer(body))

	mac := hmac.New(sha256.New, []byte(secret))
	mac.Write(body)
	expectedSignature := hex.EncodeToString(mac.Sum(nil))

	return body, hmac.Equal([]byte(signature), []byte(expectedSignature))
}
