// SQLite permits exactly one writer at a time. Allowing a pool of writers does
// not increase throughput; it converts contention into "database is locked"
// errors. One open connection, serialised by the pool, is both faster and
// correct under concurrent writes.
const (
	maxOpenConns   = 1
	maxIdleConns   = 1
	connectTimeout = 10 * time.Second
)

// NewDB opens the SQLite database file named by cfg.DBName and applies the
// pragmas a server workload needs.
func NewDB(cfg *config.AppConfig) (*sql.DB, error) {
	path := cfg.DBName
	if path == "" {
		path = "app.db"
	}

	// _pragma parameters are applied to every connection the pool opens:
	//   journal_mode=WAL  readers no longer block the writer
	//   busy_timeout      wait rather than failing instantly on contention
	//   foreign_keys=on   SQLite ignores foreign keys unless asked, which lets
	//                     orphaned rows accumulate silently
	dsn := fmt.Sprintf(
		"file:%s?_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)&_pragma=foreign_keys(on)",
		path,
	)

	db, err := sql.Open("sqlite", dsn)
	if err != nil {
		return nil, fmt.Errorf("invalid sqlite dsn: %w", err)
	}

	db.SetMaxOpenConns(maxOpenConns)
	db.SetMaxIdleConns(maxIdleConns)

	ctx, cancel := context.WithTimeout(context.Background(), connectTimeout)
	defer cancel()

	if err := db.PingContext(ctx); err != nil {
		_ = db.Close()
		return nil, fmt.Errorf("cannot open sqlite database %q: %w", path, err)
	}

	return db, nil
}
