-- name: GetAccountByID :one
SELECT id, tenant_id, email, full_name, balance_cents, is_active, created_at, updated_at
FROM accounts
WHERE id = $1 AND tenant_id = $2
LIMIT 1;

-- name: ListAccountsByTenant :many
SELECT id, tenant_id, email, full_name, balance_cents, is_active, created_at, updated_at
FROM accounts
WHERE tenant_id = $1
ORDER BY created_at DESC
LIMIT $2 OFFSET $3;

-- name: CreateAccount :one
INSERT INTO accounts (
    tenant_id, email, full_name, balance_cents, is_active
) VALUES (
    $1, $2, $3, $4, $5
)
RETURNING id, tenant_id, email, full_name, balance_cents, is_active, created_at, updated_at;

-- name: UpdateAccountBalance :one
UPDATE accounts
SET balance_cents = balance_cents + $3,
    updated_at = CURRENT_TIMESTAMP
WHERE id = $1 AND tenant_id = $2
RETURNING id, tenant_id, email, full_name, balance_cents, is_active, created_at, updated_at;

-- name: DeleteAccount :exec
DELETE FROM accounts
WHERE id = $1 AND tenant_id = $2;
