package secrets

import (
	"context"
	"encoding/json"
	"fmt"

	"github.com/aws/aws-sdk-go-v2/aws"
	"github.com/aws/aws-sdk-go-v2/service/secretsmanager"
)

// AWSSecretsClient fetches encrypted secrets from AWS Secrets Manager.
type AWSSecretsClient struct {
	client *secretsmanager.Client
}

// NewAWSSecretsClient constructs an AWS Secrets Manager client instance.
func NewAWSSecretsClient(cfg aws.Config) *AWSSecretsClient {
	return &AWSSecretsClient{
		client: secretsmanager.NewFromConfig(cfg),
	}
}

// GetSecretJSON retrieves and decodes a JSON-formatted secret payload.
func (c *AWSSecretsClient) GetSecretJSON(ctx context.Context, secretName string, target interface{}) error {
	input := &secretsmanager.GetSecretValueInput{
		SecretId: aws.String(secretName),
	}

	result, err := c.client.GetSecretValue(ctx, input)
	if err != nil {
		return fmt.Errorf("failed to retrieve secret '%s': %w", secretName, err)
	}

	if result.SecretString == nil {
		return fmt.Errorf("secret '%s' contains binary data, not string", secretName)
	}

	err = json.Unmarshal([]byte(*result.SecretString), target)
	if err != nil {
		return fmt.Errorf("failed to parse secret JSON for '%s': %w", secretName, err)
	}

	return nil
}
