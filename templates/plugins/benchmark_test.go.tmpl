package bench_test

import (
	"crypto/sha256"
	"encoding/json"
	"sync"
	"testing"
)

// BenchmarkDataModel represents an optimized struct payload for memory profiling.
type BenchmarkDataModel struct {
	ID        string `json:"id"`
	UserID    string `json:"user_id"`
	Amount    int64  `json:"amount"`
	Timestamp int64  `json:"timestamp"`
	IsActive  bool   `json:"is_active"`
}

// Global sink to prevent compiler dead-code elimination
var benchmarkSink any

// BenchmarkJSONMarshalAllocations measures JSON encoding throughput and heap allocations.
func BenchmarkJSONMarshalAllocations(b *testing.B) {
	model := BenchmarkDataModel{
		ID:        "tx_998877665544",
		UserID:    "usr_1122334455",
		Amount:    5000000,
		Timestamp: 1720000000,
		IsActive:  true,
	}

	b.ReportAllocs()
	b.ResetTimer()

	for i := 0; i < b.N; i++ {
		bytes, err := json.Marshal(&model)
		if err != nil {
			b.Fatal(err)
		}
		benchmarkSink = bytes
	}
}

// BenchmarkSHA256ZeroAlloc measures cryptographic hashing throughput.
func BenchmarkSHA256ZeroAlloc(b *testing.B) {
	data := []byte("aetheris_high_throughput_cryptographic_payload_benchmark")
	h := sha256.New()

	b.ReportAllocs()
	b.ResetTimer()

	for i := 0; i < b.N; i++ {
		h.Reset()
		h.Write(data)
		digest := h.Sum(nil)
		benchmarkSink = digest
	}
}

// BenchmarkParallelConcurrency measures sync.Pool and worker concurrency contention under load.
func BenchmarkParallelConcurrency(b *testing.B) {
	pool := sync.Pool{
		New: func() any {
			return make([]byte, 1024)
		},
	}

	b.ReportAllocs()
	b.ResetTimer()

	b.RunParallel(func(pb *testing.PB) {
		for pb.Next() {
			buf := pool.Get().([]byte)
			buf[0] = 0xFF
			pool.Put(buf)
		}
	})
}
