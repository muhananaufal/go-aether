package server

import (
	"context"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"
)

// GracefulDrainManager handles zero-downtime server shutdown.
type GracefulDrainManager struct {
	logger  *slog.Logger
	timeout time.Duration
}

// NewGracefulDrainManager creates a new connection drain manager.
func NewGracefulDrainManager(logger *slog.Logger, timeout time.Duration) *GracefulDrainManager {
	if logger == nil {
		logger = slog.Default()
	}
	if timeout == 0 {
		timeout = 30 * time.Second
	}
	return &GracefulDrainManager{
		logger:  logger,
		timeout: timeout,
	}
}

// Wait blocks until an interrupt signal is received, then gracefully shuts down the provided servers.
func (m *GracefulDrainManager) Wait(servers ...*http.Server) {
	stop := make(chan os.Signal, 1)
	signal.Notify(stop, os.Interrupt, syscall.SIGTERM)

	// Block until signal is received
	sig := <-stop
	m.logger.Info("shutting down server gracefully...", "signal", sig)

	// Create timeout context for forceful shutdown if graceful takes too long
	ctx, cancel := context.WithTimeout(context.Background(), m.timeout)
	defer cancel()

	for _, srv := range servers {
		if srv != nil {
			if err := srv.Shutdown(ctx); err != nil {
				m.logger.Error("server forced to shutdown", "err", err)
			}
		}
	}

	m.logger.Info("server exiting")
}
