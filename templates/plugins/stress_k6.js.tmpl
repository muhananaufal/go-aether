import http from 'k6/http';
import { check, sleep } from 'k6';
import { Counter, Rate, Trend } from 'k6/metrics';

// Custom Prometheus-compatible metrics
const errorRate = new Rate('errors');
const transactionLatency = new Trend('transaction_duration_ms');
const throughputCounter = new Counter('total_transactions');

export const options = {
  scenarios: {
    stress_test: {
      executor: 'ramping-vus',
      startVUs: 0,
      stages: [
        { duration: '30s', target: 50 },    // Warm-up ramp
        { duration: '1m', target: 200 },    // Ramp up to high load
        { duration: '2m', target: 500 },    // Peak stress (10k+ RPS)
        { duration: '30s', target: 0 },     // Graceful ramp down
      ],
      gracefulRampDown: '10s',
    },
  },
  thresholds: {
    http_req_failed: ['rate<0.01'],         // Error rate must be < 1%
    http_req_duration: ['p(95)<50', 'p(99)<100'], // 95% < 50ms, 99% < 100ms
    errors: ['rate<0.01'],
  },
};

const BASE_URL = __ENV.BASE_URL || 'http://localhost:8080';

export default function () {
  const params = {
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json',
      'X-Request-ID': `k6-${__VU}-${__ITER}`,
    },
    timeout: '5s',
  };

  // 1. Health check probe
  const healthRes = http.get(`${BASE_URL}/healthz`, params);
  const healthOk = check(healthRes, {
    'healthz status is 200': (r) => r.status === 200,
  });
  errorRate.add(!healthOk);

  // 2. Main API load benchmark
  const start = Date.now();
  const res = http.get(`${BASE_URL}/api/v1/ping`, params);
  const duration = Date.now() - start;

  transactionLatency.add(duration);
  throughputCounter.add(1);

  const success = check(res, {
    'status is 200 or 404': (r) => r.status === 200 || r.status === 404,
    'response under 100ms': () => duration < 100,
  });

  errorRate.add(!success);

  // Realistic jitter sleep (10ms - 50ms)
  sleep(Math.random() * 0.04 + 0.01);
}
