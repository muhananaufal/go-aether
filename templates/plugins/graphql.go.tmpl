package graphql

import (
	"log"
	"net/http"
	"os"

	"github.com/99designs/gqlgen/graphql/handler"
	"github.com/99designs/gqlgen/graphql/playground"
)

// Define your GraphQL server setup here.
// You must run `go run github.com/99designs/gqlgen init` to bootstrap the schema.
// This is a placeholder for the GraphQL handler setup.

func SetupGraphQLServer() {
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}

	// This assumes you have generated the executable schema using gqlgen.
	// srv := handler.NewDefaultServer(graph.NewExecutableSchema(graph.Config{Resolvers: &graph.Resolver{}}))

	// Placeholder server
	srv := handler.NewDefaultServer(nil) // Replace with your executable schema

	http.Handle("/", playground.Handler("GraphQL playground", "/query"))
	http.Handle("/query", srv)

	log.Printf("connect to http://localhost:%s/ for GraphQL playground", port)
	log.Fatal(http.ListenAndServe(":"+port, nil))
}
