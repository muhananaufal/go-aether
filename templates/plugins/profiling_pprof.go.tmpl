package profiling

import (
	"crypto/subtle"
	"net/http"
	"net/http/pprof"
	"strings"
)

// RegisterProtectedPprof attaches standard pprof debugging handlers protected by an admin token.
func RegisterProtectedPprof(mux *http.ServeMux, adminToken string) {
	authMiddleware := func(next http.HandlerFunc) http.HandlerFunc {
		return func(w http.ResponseWriter, r *http.Request) {
			if adminToken != "" {
				authHeader := r.Header.Get("Authorization")
				token := strings.TrimPrefix(authHeader, "Bearer ")
				if subtle.ConstantTimeCompare([]byte(token), []byte(adminToken)) != 1 {
					http.Error(w, `{"error":"Unauthorized profiling access"}`, http.StatusUnauthorized)
					return
				}
			}
			next(w, r)
		}
	}

	mux.HandleFunc("/debug/pprof/", authMiddleware(pprof.Index))
	mux.HandleFunc("/debug/pprof/cmdline", authMiddleware(pprof.Cmdline))
	mux.HandleFunc("/debug/pprof/profile", authMiddleware(pprof.Profile))
	mux.HandleFunc("/debug/pprof/symbol", authMiddleware(pprof.Symbol))
	mux.HandleFunc("/debug/pprof/trace", authMiddleware(pprof.Trace))
}
