package mailer

import (
	"context"
	"fmt"
	"net/smtp"
	"strings"
)

// EmailMessage defines payload for transactional emails.
type EmailMessage struct {
	From        string
	To          []string
	Subject     string
	HTMLBody    string
	TextBody    string
}

// Mailer provides high-level sending abstractions.
type Mailer interface {
	Send(ctx context.Context, msg EmailMessage) error
}

// SMTPMailer implements Mailer via standard SMTP protocol.
type SMTPMailer struct {
	host     string
	port     int
	username string
	password string
	from     string
}

// NewSMTPMailer constructs an SMTP mailer instance.
func NewSMTPMailer(host string, port int, username, password, defaultFrom string) *SMTPMailer {
	return &SMTPMailer{
		host:     host,
		port:     port,
		username: username,
		password: password,
		from:     defaultFrom,
	}
}

// Send dispatches email via SMTP server.
func (m *SMTPMailer) Send(ctx context.Context, msg EmailMessage) error {
	from := msg.From
	if from == "" {
		from = m.from
	}

	addr := fmt.Sprintf("%s:%d", m.host, m.port)
	var auth smtp.Auth
	if m.username != "" && m.password != "" {
		auth = smtp.PlainAuth("", m.username, m.password, m.host)
	}

	mime := "MIME-version: 1.0;\nContent-Type: text/html; charset=\"UTF-8\";\n\n"
	subject := "Subject: " + msg.Subject + "\n"
	body := []byte(subject + mime + msg.HTMLBody)

	err := smtp.SendMail(addr, auth, from, msg.To, body)
	if err != nil {
		return fmt.Errorf("failed to dispatch smtp email to [%s]: %w", strings.Join(msg.To, ","), err)
	}
	return nil
}
