package search

import (
	"fmt"

	"github.com/meilisearch/meilisearch-go"
)

// Client wraps Meilisearch full-text search engine client.
type Client struct {
	client *meilisearch.Client
}

// Config binds Meilisearch connection parameters.
type Config struct {
	Host   string
	APIKey string
}

// NewClient instantiates a Meilisearch client.
func NewClient(cfg Config) *Client {
	client := meilisearch.NewClient(meilisearch.ClientConfig{
		Host:   cfg.Host,
		APIKey: cfg.APIKey,
	})
	return &Client{client: client}
}

// AddDocuments indexes an array of documents under a designated index uid.
func (c *Client) AddDocuments(indexUID string, documents any) (*meilisearch.TaskInfo, error) {
	index := c.client.Index(indexUID)
	task, err := index.AddDocuments(documents)
	if err != nil {
		return nil, fmt.Errorf("search: indexing failed: %w", err)
	}
	return task, nil
}

// Search queries an index with fuzzy typo-tolerant matching.
func (c *Client) Search(indexUID, query string, limit int64) (*meilisearch.SearchResponse, error) {
	index := c.client.Index(indexUID)
	resp, err := index.Search(query, &meilisearch.SearchRequest{
		Limit: limit,
	})
	if err != nil {
		return nil, fmt.Errorf("search: query failed: %w", err)
	}
	return resp, nil
}
